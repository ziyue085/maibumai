{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ziyue085/maibumai/schemas/decision.schema.json",
  "title": "maibumai decision draft",
  "description": "一次消费决策的草稿。mbm.py check 校验它，mbm.py judge 校验并落账。",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "留空则自动生成 YYYYMMDD-HHMM-xxxx"
    },
    "level": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3"
      ],
      "description": "只能往上调；低于系统判定会被拦"
    },
    "as_of": {
      "type": "string",
      "description": "校验基准日 YYYY-MM-DD，默认今天"
    },
    "product": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "price": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "到手价，必须是正的有限数。0、负数、NaN、Infinity 都会被当成『金额还没定下来』：不参与分级与预算，结论降为暂缓"
        },
        "currency": {
          "type": "string",
          "default": "CNY",
          "description": "与画像基准币种不同时必须给 fx 证据"
        },
        "category": {
          "type": "string",
          "description": "如 数码/耳机、家具/椅子、会员/订阅"
        },
        "period": {
          "type": "string",
          "enum": [
            "once",
            "month",
            "quarter",
            "year"
          ],
          "description": "订阅必填；缺失时按重决策处理，且阻断购买类结论"
        },
        "condition": {
          "type": "string",
          "description": "new / used / refurbished，用于约束检查"
        },
        "portable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "url": {
          "type": "string"
        },
        "spec": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "description": "商品型号。报价证据可用 model 标明指的是哪一件商品；并列多个型号且未指定要买哪个时，只能暂缓"
        },
        "variant": {
          "type": "string",
          "description": "规格/SKU（如 256GB、Pro 版）。**规格不同就是不同的商品**：不同规格的价格不得直接比较，也不得默认按最便宜的规格下结论。用户明确指定规格时，只拿规格吻合的报价去比"
        },
        "region": {
          "type": "string",
          "description": "地区/版本（如 CN、US、港版）。不同地区/版本的价格不得混用"
        }
      },
      "required": [
        "name"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "description": "规则码 + 具体依据。L2 至少 2 条、L3 至少 3 条；note 少于 6 字会被拦",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "谁、多少、什么时候——写成别人能复核的一句话"
          }
        },
        "required": [
          "code",
          "note"
        ]
      }
    },
    "alternative": {
      "type": [
        "object",
        "null"
      ],
      "description": "建议替换方案时必填。必须同时具备名称、价格、来源；订阅类还要 period；且要有一条 subject=alternative 的价格证据。缺任何一项都不会给出「建议替换方案」。",
      "properties": {
        "name": {
          "type": "string"
        },
        "price": {
          "type": [
            "number",
            "null"
          ],
          "description": "正数；外币请同时给 currency"
        },
        "currency": {
          "type": "string",
          "description": "不填则按商品原币种处理"
        },
        "period": {
          "type": "string",
          "enum": [
            "once",
            "month",
            "quarter",
            "year"
          ],
          "description": "订阅类必填，否则年化成本无法比较"
        },
        "category": {
          "type": "string",
          "description": "不填则继承商品品类"
        },
        "source": {
          "type": "string",
          "description": "能核实它真的存在、真的卖这个价"
        },
        "why": {
          "type": "string",
          "description": "满足了多少需求、牺牲了什么"
        },
        "price_note": {
          "type": "string",
          "description": "仅作补充说明，不能替代 price"
        },
        "model": {
          "type": "string",
          "description": "替代品型号，用于与目标商品身份对齐"
        },
        "variant": {
          "type": "string",
          "description": "替代品规格/SKU；与目标商品用同一套身份匹配规则"
        },
        "region": {
          "type": "string",
          "description": "替代品地区/版本"
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "每条主张的来源、等级、观测日期。规则见 references/evidence-policy.md",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "price",
              "promo",
              "price_history",
              "spec",
              "review",
              "safety",
              "fx",
              "other"
            ]
          },
          "claim": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "价格/汇率本身的数值。必须是正的有限数：0、负数、NaN、Infinity、布尔值都不成立（EV_PRICE_VALUE_INVALID）。null 表示换算不出来"
          },
          "currency": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "enum": [
              "target",
              "reference",
              "alternative"
            ],
            "default": "target",
            "description": "target=被评估商品；reference=用来比价的参照商品（不参与冲突检测）；alternative=推荐的替代品自己的报价（SWITCH 的必要依据）"
          },
          "base": {
            "type": "string",
            "enum": [
              "CNY",
              "USD",
              "EUR",
              "JPY",
              "HKD",
              "GBP",
              "KRW",
              "TWD",
              "SGD"
            ],
            "description": "仅 fx 类：源币种。**不在列表里的币种一律不参与换算**（FX_BAD_CURRENCY），数值再漂亮也没用"
          },
          "quote": {
            "type": "string",
            "enum": [
              "CNY",
              "USD",
              "EUR",
              "JPY",
              "HKD",
              "GBP",
              "KRW",
              "TWD",
              "SGD"
            ],
            "description": "仅 fx 类：目标币种。规则同 base；两侧相同视为不需要汇率"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "official",
              "authorized_retail",
              "third_party",
              "user_provided",
              "ugc"
            ]
          },
          "url": {
            "type": "string",
            "description": "可点开的报价链接。⚠️ 系统只做**结构检查**（scheme + host），不代表链接可访问、域名权威或页面写着这个价。"
          },
          "observed_at": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "page_price": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "取证方读完页面后原样记下的价格，必须是正的有限数。填了且与 value 一致（±2%）只算 reported（取证方自述）；要拿 content 级必须另外给 page_text，且正文里这个数确实以**价格**身份出现（型号/容量/销量里的数字不算）。填 0、负数、布尔、NaN、Infinity 判 EV_PAGE_PRICE_INVALID；不填或填 null 只到 source 级。⚠️ 单独给 page_price_set 不算页面内容：那是取证方列的数字，最多 reported。"
          },
          "page_text": {
            "type": "string",
            "description": "页面上包含该价格的一段正文（或全文）。只有给了它、且引擎在正文里以价格语境找到这个数，才配叫 content 级「页面核对过」。"
          },
          "page_text_sha256": {
            "type": "string",
            "description": "page_text 的 sha256，由引擎重算比对。它只能证明**这段正文没被改过**，不能证明正文来自那个 URL，也不能证明域名是官方渠道。"
          },
          "page_price_set": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "页面上出现过的价格集合。**仅此一项不能获得 content 级**——它是取证方自己列的一串数字，不是可复核的页面正文；引擎不接受它作为独立证据。"
          },
          "price_basis": {
            "type": "string",
            "enum": [
              "tax_inclusive",
              "street",
              "promo",
              "msrp",
              "tax_exclusive"
            ],
            "description": "价格口径。不同口径的价可以同时为真（官方标价 1099 与促销 899 不是数据打架，报 EV_PRICE_BASIS_DIFF）。到手价优先级：tax_inclusive > street > promo > msrp > tax_exclusive。不填视为 unknown：无法判断是否可比，差 5% 以上时暂缓（EV_PRICE_BASIS_UNKNOWN）。"
          },
          "variant": {
            "type": "string",
            "description": "规格/型号（如 128GB、256GB）。规格不同的报价不是同一商品，不参与冲突判定；并列存在且未标明要买哪个时暂缓。"
          },
          "region": {
            "type": "string",
            "description": "销售地区（如 CN、US）。地区差价是正常商业事实，不是数据错误；未标明要买哪个版本时暂缓。"
          },
          "model": {
            "type": "string",
            "description": "这条报价说的是哪个型号；与 variant/region 一起构成商品身份"
          },
          "require_page_hash": {
            "type": "boolean",
            "description": "置 true 表示要求哈希核验：此时必须提供 page_text_sha256，否则拿不到 content 级"
          }
        },
        "required": [
          "kind",
          "claim",
          "source_type"
        ]
      }
    },
    "prediction": {
      "type": "object",
      "description": "对未来的预测，用于日后校准。宁可填得保守，不要填得漂亮。",
      "properties": {
        "uses_per_month": {
          "type": [
            "number",
            "null"
          ]
        },
        "months": {
          "type": [
            "number",
            "null"
          ]
        },
        "satisfaction": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "numbers": {
      "type": "object",
      "description": "由脚本计算，一般不用手填"
    },
    "recheck_condition": {
      "type": "string",
      "description": "结论为暂缓时必填：什么时点或什么条件下重新判断"
    },
    "override": {
      "type": [
        "object",
        "null"
      ],
      "description": "人工调整。只能往更保守的方向走；不能把暂缓改成购买，也不能绕过硬拦截",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "BUY",
            "SWITCH",
            "DEFER",
            "DONT_BUY"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "一句话结论，会参与废话与最高级表述检测"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "product",
    "reasons"
  ]
}
