{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ziyue085/maibumai/schemas/profile.schema.json",
  "title": "maibumai profile v2",
  "description": "个人画像。按事实存储，每条带 updated_at，过期需重新确认。值允许为 null —— 不知道就不填，不猜。",
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "created_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]},
    "meta": {
      "type": "object",
      "properties": {
        "base_currency": {"type": "string", "default": "CNY", "description": "所有金额的计价基准"},
        "owner_label": {"type": "string", "description": "可留空；仅本机显示用"}
      }
    },
    "facts": {
      "type": "object",
      "description": "扁平事实表。键名与保鲜期见 references/profile-system.md",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {"type": ["number", "boolean", "string", "array", "null"]},
          "updated_at": {"type": "string", "description": "YYYY-MM-DD"},
          "note": {"type": "string"}
        },
        "required": ["value", "updated_at"]
      }
    },
    "constraints": {
      "type": "object",
      "description": "硬约束：为 true 时违反即不建议购买，由引擎强制判定",
      "properties": {
        "no_used": {"type": "boolean", "default": false, "description": "不买二手"},
        "no_subscription": {"type": "boolean", "default": false, "description": "不再增加订阅"},
        "must_be_portable": {"type": "boolean", "default": false, "description": "必须可携带"},
        "notes": {"type": "string", "description": "自由文本约束，由模型自行判断"}
      }
    },
    "behavior": {
      "type": "object",
      "properties": {
        "impulse_cooldown_hours": {"type": "integer", "default": 72},
        "small_amount_fastpath": {"type": "number", "default": 100},
        "review_days": {"type": "integer", "default": 60}
      }
    }
  },
  "required": ["schema_version", "facts"]
}
