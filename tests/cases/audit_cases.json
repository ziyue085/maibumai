{
  "meta": {
    "purpose": "输出审计夹具。检查结论是否自洽、具体、可核验。",
    "legend": "expect 必须全部出现；多出的阻断必须在 allow 里。expect_ok=true 表示零阻断。"
  },
  "cases": [
    {
      "id": "A01",
      "name": "暂缓但没有复查条件",
      "expect_ok": false,
      "expect": ["AUD_DEFER_NO_RECHECK"],
      "decision": {
        "verdict": "DEFER",
        "level": "L2",
        "product": {"name": "某平板", "price": 2499},
        "reasons": [
          {"code": "IMPULSE_SIGNAL", "note": "看到限时折扣才想买"},
          {"code": "PRICE_UNVERIFIED", "note": "没查到近两周的公开报价"}
        ]
      },
      "why": "『再想想』不是答案。暂缓必须说清什么条件下可以买。"
    },
    {
      "id": "A02",
      "name": "建议购买但价格只有用户口述",
      "expect_ok": false,
      "expect": ["AUD_PRICE_UNVERIFIED"],
      "decision": {
        "verdict": "BUY",
        "level": "L2",
        "product": {"name": "某耳机", "price": 899},
        "reasons": [
          {"code": "NEED_REAL", "note": "旧耳机降噪失效已三个月"},
          {"code": "AFFORDABLE_WITHIN_BUDGET", "note": "占月可支配四成"}
        ],
        "evidence": [
          {"kind": "price", "value": 899, "source_type": "user_provided", "observed_at": "2026-10-29"}
        ]
      },
      "why": "口述价格可以用于暂缓，但不能用来断言『价格合理』。"
    },
    {
      "id": "A03",
      "name": "理由指向暂缓，结论却写建议购买",
      "expect_ok": false,
      "expect": ["AUD_TIER_CONFLICT"],
      "decision": {
        "verdict": "BUY",
        "level": "L2",
        "product": {"name": "某联名球鞋", "price": 1299},
        "reasons": [
          {"code": "NEED_REAL", "note": "常穿的那双鞋底已磨穿"},
          {"code": "IMPULSE_SIGNAL", "note": "看到联名款才起意购买"}
        ],
        "evidence": [
          {"kind": "price", "value": 1299, "source_type": "official", "url": "https://example.com/a", "observed_at": "2026-10-29"}
        ]
      },
      "why": "自相矛盾是最常见的失败模式，必须结构上拦住。"
    },
    {
      "id": "A04",
      "name": "把判断推回给用户的废话",
      "expect_ok": false,
      "expect": ["AUD_VAGUE_PHRASE"],
      "decision": {
        "verdict": "DEFER",
        "level": "L2",
        "product": {"name": "某咖啡机", "price": 3200},
        "summary": "这个主要看你自己，因人而异。",
        "reasons": [
          {"code": "INFO_GAP", "note": "没说要做什么类型的咖啡"},
          {"code": "PRICE_UNVERIFIED", "note": "没有型号无法比价"}
        ],
        "recheck_condition": "补上型号与使用频率后再看"
      },
      "why": "用户要的是判断，不是被反问。"
    },
    {
      "id": "A05",
      "name": "无历史数据却说历史最低",
