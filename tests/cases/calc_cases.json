    {
      "id": "C28",
      "fn": "budget_status",
      "name": "18000 元 vs 月结余 2000：是紧张，不是买不起",
      "args": [
        18000,
        {
          "facts": {
            "finance.discretionary_override": {
              "value": 2000,
              "updated_at": "TODAY"
            },
            "finance.liquid_cash": {
              "value": 0,
